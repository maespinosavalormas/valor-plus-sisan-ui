{
  "name": "sisan-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "serve:ssr:sisan-app": "node dist/sisan-app/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.4",
    "@bluehalo/ngx-leaflet": "^21.2.1",
    "@ngrx/component": "^21.0.1",
    "@ngrx/effects": "^21.0.1",
    "@ngrx/entity": "^21.0.1",
    "@ngrx/store": "^21.0.1",
    "@ngrx/store-devtools": "^21.0.1",
    "@types/leaflet": "^1.9.21",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "ng2-charts": "^5.0.4",
    "ngx-mat-select-search": "^8.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@ngneat/spectator": "^22.1.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.33",
    "@types/testing-library__jest-dom": "^5.14.9",
    "jest": "^29.7.0",
    "jest-preset-angular": "^13.1.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.2",
    "zone.js": "^0.16.2"
